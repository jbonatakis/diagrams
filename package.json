{
  "name": "diagrams",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/assets.mjs && tsc -b && vite build",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "mcp": "node --env-file-if-exists=.env scripts/mcp.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "ajv": "^8.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
