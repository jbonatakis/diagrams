{
  "get_diagram": {
    "description": "Read the connected browser's live diagram, including its diagramId, revision, shapes, labels, positions, styles, and arrow bindings. Read before editing. There is one connected browser in this phase 1 prototype. The diagram is held in browser memory and resets on reload.",
    "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
  },
  "apply_operations": {
    "description": "Create shapes, connect them with straight bound arrows, or move shapes in the connected browser. Read get_diagram first and pass its diagramId and revision. A batch is one undo step. Coordinates are canvas coordinates. Moves support rectangles, ellipses, diamonds, and standalone text; bound straight arrows and shape labels follow. Complex or elbow connectors are not supported by agent moves in phase 1. Errors leave the diagram unchanged. Do not blindly retry after a timeout; inspect the diagram first.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagramId", "expectedRevision", "operations"],
      "properties": {
        "diagramId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "expectedRevision": { "type": "integer", "minimum": 0 },
        "operations": {
          "type": "array", "minItems": 1, "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["op", "id", "shape", "x", "y"],
                "properties": {
                  "op": { "const": "create_shape" },
                  "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
                  "shape": { "enum": ["rectangle", "ellipse", "diamond"] },
                  "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  "width": { "type": "number", "minimum": 20, "maximum": 10000, "default": 180 },
                  "height": { "type": "number", "minimum": 20, "maximum": 10000, "default": 100 },
                  "label": { "type": "string", "maxLength": 1000 },
                  "fill": { "type": "string", "pattern": "^(transparent|#[0-9a-fA-F]{6})$" },
                  "stroke": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["op", "id", "fromId", "toId"],
                "properties": {
                  "op": { "const": "connect" },
                  "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
                  "fromId": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "toId": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "stroke": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                  "strokeStyle": { "enum": ["solid", "dashed", "dotted"] },
                  "strokeWidth": { "type": "number", "minimum": 1, "maximum": 8 },
                  "startArrowhead": { "enum": ["none", "arrow", "triangle"] },
                  "endArrowhead": { "enum": ["none", "arrow", "triangle"] }
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["op", "id", "x", "y"],
                "properties": {
                  "op": { "const": "move" },
                  "id": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
