DIAGRAMS_PUBLIC_URL=https://diagrams.bonatak.is
DIAGRAMS_PORT=8788
# Hosted R2 exports stay disabled until the bucket, checksums, lifecycle policy,
# direct PUT limits, and the $0.01 billing alert have been verified.
DIAGRAMS_R2_ENABLED=false
DIAGRAMS_R2_ENFORCEMENT_VERIFIED=false
DIAGRAMS_R2_ENDPOINT=https://57e15fb8fe6aa2279e2c73b3c077a4ef.r2.cloudflarestorage.com
DIAGRAMS_R2_BUCKET=diagrams-exports-prod
DIAGRAMS_R2_ACCESS_KEY_ID=
# Keep these files outside the deployment archive and source tree.
# Set these to absolute paths outside the deployment archive when enabling R2.
# On Linux, the mounted files must be readable by container UID 10001; see R2_SETUP.md.
DIAGRAMS_R2_SECRET_ACCESS_KEY_FILE=
DIAGRAMS_DOWNLOAD_SIGNING_KEY_FILE=
